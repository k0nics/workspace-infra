local.file_match "laravel" {
  path_targets = [
    {
      "__path__" = "/var/log/laravel/tisph-cms/laravel*.log",
      "job"      = "laravel",
      "app"      = "tisph-cms",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/tisph-website/laravel*.log",
      "job"      = "laravel",
      "app"      = "tisph-website",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/tfs-website/laravel*.log",
      "job"      = "laravel",
      "app"      = "tfs-website",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/tfs-cms/laravel*.log",
      "job"      = "laravel",
      "app"      = "tfs-cms",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/sgv-website/laravel*.log",
      "job"      = "laravel",
      "app"      = "sgv-website",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/sgv-cms/laravel*.log",
      "job"      = "laravel",
      "app"      = "sgv-cms",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/ortigas-land-website/laravel*.log",
      "job"      = "laravel",
      "app"      = "ortigas-land-website",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/ortigas-land-cms/laravel*.log",
      "job"      = "laravel",
      "app"      = "ortigas-land-cms",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/globe-digitest/laravel*.log",
      "job"      = "laravel",
      "app"      = "globe-digitest",
      "env"      = "local",
    },
    {
      "__path__" = "/var/log/laravel/qms-cron/laravel*.log",
      "job"      = "laravel",
      "app"      = "qms-cron",
      "env"      = "local",
    },
  ]
}

loki.source.file "laravel" {
  targets = local.file_match.laravel.targets

  forward_to = [
    loki.process.laravel.receiver,
  ]
}

loki.process "laravel" {
  stage.multiline {
    firstline     = "^\\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\]"
    max_lines     = 512
    max_wait_time = "3s"
  }

  forward_to = [
    loki.write.default.receiver,
  ]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
